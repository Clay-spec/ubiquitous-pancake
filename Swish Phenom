if onInput then
    getgenv().onInput:Disconnect()
    getgenv().onInput = nil
end

if renderStepped then
    getgenv().renderStepped:Disconnect()
    getgenv().renderStepped = nil
end

local replicatedStorage = game:GetService("ReplicatedStorage")
local memStorageService = game:GetService("MemStorageService")
local userInputService = game:GetService("UserInputService")
local runService = game:GetService("RunService")
local players = game:GetService("Players")

local actor = memStorageService:FindFirstChildWhichIsA("Actor")
local id, channel = create_comm_channel()

local localPlayer = players.LocalPlayer
local character = localPlayer.Character

local head = character.Head
local torso = character.Torso

local humanoid = character.Humanoid
local root = character.HumanoidRootPart

local playerGui = localPlayer.PlayerGui
local powerFrame = playerGui.Game.Power

local network = require(replicatedStorage.Shared.Network)

local HL = Instance.new("Highlight")
HL.Enabled = false
HL.Adornee = character
HL.FillColor = Color3.fromRGB(25, 255, 25)
HL.OutlineColor = Color3.fromRGB(0, 255, 0)
HL.Parent = playerGui

local isInFooting = false

local goals = {} do
    for _, goal in workspace.Map.Stadium:GetDescendants() do
        if goal:IsA("BasePart") and goal.Name == "Goal" then
            table.insert(goals, goal)
        end
    end
end

local function onChannelEvent(
    channel,
    callback:(throwingResult) -> ()
)
    return channel.Event:Connect(callback)
end

local function getBall()
    return character:FindFirstChild("Basketball")
end

local function getGoal()
    local distance, getClosestGoal = 9e9

    for _, goal in goals do
        local magnitude = (root.Position - goal.Position).Magnitude

        if magnitude < distance then
            distance = magnitude
            getClosestGoal = goal 
        end
    end
    return getClosestGoal, distance
end

local function getSpawnPos(
    shotDirection: vector
)
	local unit = (shotDirection - head.Position).Unit
	return torso.Position + unit * 5
end

local function getPower()
    return tonumber(powerFrame.Text.Text)
end

local function inFootingCheck()
    local goal, distance = getGoal()
    local basketball = getBall()
    
    local power = tonumber(getPower())

    if power == 75 then
        isInFooting = distance > 57 and distance < 61

    elseif power == 80 then
        isInFooting = distance > 57 and distance < 69

    elseif power == 85 then
        isInFooting = distance > 57 and distance < 74

    elseif power == 90 then
        isInFooting = distance > 57 and distance < 79

    elseif power == 95 then
        isInFooting = distance > 57 and distance < 86

    elseif power == 100 then
        isInFooting = distance > 57 and distance < 93

    else
        isInFooting = false
    end

    return isInFooting
end

