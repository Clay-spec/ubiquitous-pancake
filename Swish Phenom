local function shoot()
    local goal, distance = getGoal()
    local arc = getArc()

    local shotVector = goal.Position + Vector3.new(0, arc, 0)
    local spawnPos = getSpawnPos(shotVector)
    local power = getPower()

    run_on_actor(actor, [[
        local arguments = {...}
        local dataChannel = get_comm_channel(arguments[1])

        --lol goodluck patching this dial.
        local throwingInitFn do
            for _, fn in getgc(true) do
                if typeof(fn) == "function" then
                    local info = getinfo(fn)

                    if info.name == "init" and info.source:find("ThrowingManager") then
                        throwingInitFn = fn
                    end
                end
            end
        end

        local throwingPack = getupvalue(getupvalue(throwingInitFn, 11), 4).pack

        local shotVector = Vector3.new(arguments[2], arguments[3], arguments[4])
        local spawnPos = Vector3.new(arguments[5], arguments[6], arguments[7])
        local power = arguments[8]

        local result = throwingPack(shotVector, spawnPos, power)

        dataChannel:Fire(result)
    ]], id, shotVector.X, shotVector.Y, shotVector.Z, spawnPos.X, spawnPos.Y, spawnPos.Z, power)
end

local function onInputBegan(
    input: InputObject,
    gpe: boolean
)
    if gpe then
        return
    end

    if input.KeyCode == Enum.KeyCode.X and inFootingCheck() and getBall() ~= nil then
        if humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

            task.wait(.25)

            shoot()
        end
    end
end

local function onRenderStepped(
    dt: number
)
    local ball = getBall()

    if not ball then
        HL.Enabled = false
        return
    end

    HL.Enabled = inFootingCheck()
end

local function init()
    getgenv().onInput = userInputService.InputBegan:Connect(onInputBegan)
    getgenv().renderStepped = runService.RenderStepped:Connect(onRenderStepped)

    onChannelEvent(channel, network.Gameplay.packets.Throw.send)
end

task.spawn(init)
